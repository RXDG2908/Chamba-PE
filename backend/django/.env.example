# PowerShell: definir estas variables en la terminal que ejecuta Django.
# Ejemplo:  $env:DJANGO_DEBUG="true"

# --- Seguridad de Django ---
# true solo en desarrollo local (muestra errores detallados, sirve /media/ y el CSS del admin).
# Sin definirla, DEBUG queda apagado.
DJANGO_DEBUG=true
# Clave secreta. Obligatoria con DEBUG apagado; generar una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Nunca subirla al repositorio. Vacía + DEBUG=true = clave de desarrollo.
DJANGO_SECRET_KEY=
# Hosts permitidos, separados por comas. Por defecto: localhost,127.0.0.1,[::1]
# Para probar desde el celular en la misma red, agregar la IP de la PC, p. ej. 192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Notificaciones push (Firebase) ---
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
# App móvil: proyecto de Firebase Authentication cuyos tokens acepta la API (vacío = desactivado).
FIREBASE_AUTH_PROJECT_ID=chamba-pe-c043f
# Ruta absoluta FUERA del repositorio; nunca colocar JSON en web-portal/ ni en el repositorio.
GOOGLE_APPLICATION_CREDENTIALS=C:/credenciales/chamba-pruebas/firebase-service-account.json
